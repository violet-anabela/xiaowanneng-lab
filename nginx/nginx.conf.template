# 网关（nginx）配置模板。Zeabur 注入 PORT / BACKEND_URL / FRONTEND_URL。
# start.sh 用 envsubst 只替换这三个变量后写入 default.conf。
# 约定：前端站只暴露静态资源（由 frontend 容器托管），所有 /api 流量在此反代到 backend。
server {
    listen       ${PORT};
    server_name  _;

    server_tokens off;

    # 基础安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ===== API 反代：/api/* 转给后端（剥掉 /api 前缀）=====
    # 例如 /api/v1/remove-background -> BACKEND_URL/v1/remove-background
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 略大于后端 10MiB 限制，超限由后端统一回 413。
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # 健康检查直达后端（便于经网关排障）
    location = /livez {
        proxy_pass ${BACKEND_URL}/livez;
        proxy_set_header Host $host;
    }
    location = /readyz {
        proxy_pass ${BACKEND_URL}/readyz;
        proxy_set_header Host $host;
    }

    # ===== 其余请求：反代到前端静态站 =====
    location / {
        proxy_pass ${FRONTEND_URL}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
