# 网关（反向代理）服务构建 —— Zeabur 专用入口。
# zbpack 的 monorepo 约定：Root Directory 留空（构建上下文 = 仓库根），
# 服务环境变量设 ZBPACK_DOCKERFILE_NAME=gateway，zbpack 即选用本文件（Dockerfile.gateway）。
# 本地 compose 不用这份，用 gateway/Dockerfile（gateway/ 自包含上下文）；两份需保持同步。
FROM nginx:alpine
COPY gateway/nginx.conf.template /etc/nginx/nginx.conf.template
COPY gateway/start.sh /start.sh
RUN chmod +x /start.sh
ENV PORT=80
EXPOSE 80
CMD ["/start.sh"]
