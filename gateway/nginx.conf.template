# 网关（反向代理）配置模板。Zeabur 注入 PORT / BACKEND_URL / FRONTEND_URL。
# start.sh 用 envsubst 替换 PORT / BACKEND_URL / FRONTEND_URL / RESOLVER 后写入 default.conf。
# 约定：前端站只暴露静态资源（由 frontend 容器托管），所有 /api 流量在此反代到 backend。
server {
    listen       ${PORT};
    server_name  _;

    server_tokens off;

    # 变量形式 proxy_pass 必须在运行期解析上游主机名，nginx 要求显式配置 resolver，
    # 否则启动即报 "no resolver defined" 而崩溃。RESOLVER 由 start.sh 注入
    #（优先取 /etc/resolv.conf 的 nameserver，兜底 127.0.0.11）。
    resolver ${RESOLVER} valid=10s ipv6=off;

    # 基础安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 用变量持有上游地址：proxy_pass 用变量时不作启动期 DNS 解析，
    # 避免 Zeabur 上 nginx 先于 backend 启动时因解析不到主机名而启动失败（运行期由 Zeabur 内部 DNS 解析）。
    set $backend_upstream  "${BACKEND_URL}";
    set $frontend_upstream "${FRONTEND_URL}";

    # ===== API 反代：/api/* 转给后端（剥掉 /api 前缀）=====
    # 例如 /api/v1/remove-background -> BACKEND_URL/v1/remove-background
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 略大于后端 10MiB 限制，超限由后端统一回 413。
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # 健康检查直达后端（便于经网关排障）
    location = /livez {
        rewrite ^ /livez break;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }
    location = /readyz {
        rewrite ^ /readyz break;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
    }

    # ===== 其余请求：反代到前端静态站 =====
    location / {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
