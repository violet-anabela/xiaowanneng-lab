---
// 视频卡片：猫片墙和首页共用，外面的相框（拍立得/照片墙）各自套各自的。
//
// 点封面就地播放；左上角的放大按钮才进浮层大屏。浮层走自己的实现而不是原生全屏，
// 因为 requestFullscreen 在嵌入式环境里会被权限拦掉（直接抛 TypeError）。原生控件栏
// 自带的那个全屏按钮同样失效，已经用 controlslist + 伪元素两道一起藏掉。
//
// 封面是压在视频上的一张真图，不是 poster 属性：部分浏览器暂停、播完之后不再重绘
// 视频帧，只剩一块空白，所以只在真正播放时才把封面藏起来。
// preload=none 且首次点击才写 src，片子有几十兆，不能进页面就下载。
interface Props {
  src: string;
  poster?: string;
  label: string;
  /** 播放键尺寸，首页那张比猫片墙小一圈 */
  badge?: 'sm' | 'md';
}

const { src, poster, label, badge = 'md' } = Astro.props;
---

<div class="reel-frame" data-badge={badge} data-reel={src} data-reel-label={label}>
  <video playsinline controls controlslist="nofullscreen" preload="none" poster={poster}></video>
  <button class="video-cover" type="button" aria-label={`播放：${label}`}>
    {poster && <img src={poster} alt="" />}
    <span class="play-badge" aria-hidden="true"></span>
  </button>
  <button class="reel-expand" type="button" aria-label={`放大播放：${label}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
    </svg>
  </button>
</div>

<script>
  // ---- 浮层（大屏播放），一个页面共用一个，用到时才建 ----
  let overlay: HTMLDivElement | null = null;
  let stageVideo: HTMLVideoElement | null = null;
  let stageCap: HTMLElement | null = null;
  let source: HTMLVideoElement | null = null; // 浮层打开前正在播的那个卡片视频
  let lastTrigger: HTMLElement | null = null;

  function buildOverlay() {
    overlay = document.createElement('div');
    overlay.className = 'reel-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.hidden = true;
    overlay.innerHTML = `
      <button class="reel-close" type="button" aria-label="关闭">✕</button>
      <figure class="reel-stage">
        <video controls playsinline controlslist="nofullscreen"></video>
        <figcaption class="reel-cap"></figcaption>
      </figure>
    `;
    document.body.appendChild(overlay);
    stageVideo = overlay.querySelector('video');
    stageCap = overlay.querySelector('.reel-cap');

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeOverlay();
    });
    overlay.querySelector('.reel-close')?.addEventListener('click', closeOverlay);
  }

  function openOverlay(frame: HTMLElement, trigger: HTMLElement) {
    if (!overlay) buildOverlay();
    if (!overlay || !stageVideo || !stageCap) return;

    const inline = frame.querySelector('video');
    const src = frame.dataset.reel;
    if (!inline || !src) return;

    source = inline;
    lastTrigger = trigger;
    inline.pause(); // 接力，不要两边同时出声

    stageCap.textContent = frame.dataset.reelLabel ?? '';
    stageVideo.src = src;
    stageVideo.currentTime = inline.currentTime; // 从卡片里播到的位置接着放
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    overlay.querySelector<HTMLButtonElement>('.reel-close')?.focus();
    stageVideo.play().catch(() => {
      /* 自动播放被拦就让用户自己点控件，不算错误 */
    });
  }

  function closeOverlay() {
    if (!overlay || !stageVideo) return;
    const at = stageVideo.currentTime;
    stageVideo.pause();
    stageVideo.removeAttribute('src'); // 断掉下载，别在后台接着拉流
    stageVideo.load();
    overlay.hidden = true;
    document.body.style.overflow = '';

    // 把进度还给卡片，关掉浮层后接着从这儿看
    if (source && source.src) {
      try {
        source.currentTime = at;
      } catch {
        /* 元数据还没就绪就跳过，无所谓 */
      }
    }
    source = null;
    lastTrigger?.focus();
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay && !overlay.hidden) closeOverlay();
  });

  // ---- 卡片本身：点封面就地播放 ----
  document.querySelectorAll<HTMLElement>('.reel-frame').forEach((frame) => {
    const video = frame.querySelector('video');
    const cover = frame.querySelector('.video-cover');
    const expand = frame.querySelector('.reel-expand');
    const src = frame.dataset.reel;
    if (!video || !cover || !src) return;

    const ensureSrc = () => {
      if (!video.getAttribute('src')) video.src = src;
    };

    cover.addEventListener('click', () => {
      ensureSrc();
      video.play().catch(() => {});
    });

    // 封面只在真正开播时让位，一暂停/播完就盖回去，
    // 别让浏览器有机会在卡片上留下一块空白。
    video.addEventListener('playing', () => frame.classList.add('is-playing'));
    video.addEventListener('pause', () => frame.classList.remove('is-playing'));
    video.addEventListener('ended', () => {
      frame.classList.remove('is-playing');
      video.currentTime = 0; // 回到起点，下次点开还是从头放
    });

    expand?.addEventListener('click', () => {
      ensureSrc();
      openOverlay(frame, expand as HTMLElement);
    });
  });
</script>

<style>
  .reel-frame {
    position: relative;
    display: block;
    background: var(--ink);
  }

  .reel-frame video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    background: var(--ink);
    /* 单独提一个合成层：相框有旋转和阴影，不提层的话播放中画面会间歇性不刷新 */
    transform: translateZ(0);
    will-change: transform;
  }

  .video-cover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* 显式写死尺寸：外面的相框各有各的图片规则，别被套进去 */
  .video-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
    display: block;
  }

  .play-badge {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(35, 50, 77, 0.66);
    border: 2px solid rgba(255, 255, 255, 0.85);
    transition: transform 180ms ease, background 180ms ease;
  }

  .reel-frame[data-badge='sm'] .play-badge {
    width: 42px;
    height: 42px;
  }

  .play-badge::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border: 11px solid transparent;
    border-left-color: #fff;
    border-right-width: 0;
  }

  .reel-frame[data-badge='sm'] .play-badge::after {
    border-width: 9px;
    border-right-width: 0;
  }

  .video-cover:hover .play-badge,
  .video-cover:focus-visible .play-badge {
    transform: scale(1.08);
    background: rgba(198, 87, 51, 0.82);
  }

  .reel-frame.is-playing .video-cover { display: none; }

  /* 藏掉原生控件栏里的全屏按钮：它调的 requestFullscreen 在嵌入环境里会被权限
     拦掉，点了没反应，留着只会让人以为坏了。放大统一走左上角那个自己的按钮。 */
  .reel-frame video::-webkit-media-controls-fullscreen-button { display: none; }

  /* 放大按钮：原生全屏在嵌入环境里会被拦，这个走自己的浮层。
     放左上角是因为右上角在首页被那枚印章盖着，点击会被它吃掉。 */
  .reel-expand {
    position: absolute;
    top: 8px;
    left: 8px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    background: rgba(35, 50, 77, 0.55);
    color: #fff;
    cursor: pointer;
    opacity: 0.85;
    transition: opacity 160ms ease, background 160ms ease;
  }

  .reel-expand svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .reel-expand:hover,
  .reel-expand:focus-visible {
    opacity: 1;
    background: rgba(198, 87, 51, 0.85);
  }
</style>

<style is:global>
  /* 浮层是 JS 挂到 body 上的，作用域样式够不着，只能全局 */
  .reel-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
    background: rgba(28, 40, 62, 0.86);
  }

  .reel-lightbox[hidden] { display: none; }

  .reel-stage {
    margin: 0;
    padding: 12px 12px 8px;
    max-width: min(960px, 100%);
    background: var(--card);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .reel-stage video::-webkit-media-controls-fullscreen-button { display: none; }

  .reel-stage video {
    display: block;
    width: 100%;
    max-height: 76vh;
    background: #000;
  }

  .reel-stage .reel-cap {
    margin: 10px 4px 6px;
    text-align: center;
    font: 16px/1.3 var(--font-hand);
    color: var(--ink-soft);
  }

  .reel-close {
    position: absolute;
    top: clamp(10px, 2.5vw, 26px);
    right: clamp(10px, 2.5vw, 26px);
    width: 44px;
    height: 44px;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }

  .reel-close:hover { background: rgba(255, 255, 255, 0.24); }
</style>
