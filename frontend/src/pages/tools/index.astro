---
import Base from '../../layouts/Base.astro';
import { tools } from '../../data/tools';
---

<Base title="工具">
  <h1>工具</h1>
  <p class="muted">
    小工具集合。纯前端工具在浏览器内运行、零上传；需算力的工具由后端服务支撑。
  </p>
  <div class="card-grid" style="margin-top:20px;">
    {tools.map((t) => (
      <a class="card" href={t.status === 'available' ? `/tools/${t.slug}` : '#'}>
        <h3>{t.title}</h3>
        <p>{t.description}</p>
        <span class="tag">
          {t.needsBackend ? '需后端' : '纯前端'}
          {t.status === 'coming-soon' ? ' · 敬请期待' : ''}
        </span>
      </a>
    ))}
  </div>
</Base>
