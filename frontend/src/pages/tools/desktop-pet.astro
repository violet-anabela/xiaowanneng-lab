---
import Base from '../../layouts/Base.astro';

const slots = [
  { key: 'idle', label: '站立 / 溜达', required: true, hint: '必填，它的基本形态' },
  { key: 'eat', label: '吃饭', required: false, hint: '开饭时换这张' },
  { key: 'sleep', label: '睡觉', required: false, hint: '打盹时换这张' },
  { key: 'drag', label: '被拎起来', required: false, hint: '拖拽时换这张' },
  { key: 'click', label: '被点到', required: false, hint: '点它时闪现这张' },
];

// 预设猫档案：卡片渲染与客户端领养脚本共用（经下方 JSON script 传给浏览器）
const presets = [
  {
    key: 'shiyi',
    name: '沈十一',
    desc: '奶牛猫，溜达是警戒蹲姿，睡觉四仰八叉，被点会闭眼享受。',
    size: 104,
    images: {
      idle: '/pet/presets/shiyi-idle.png',
      sleep: '/pet/presets/shiyi-sleep.png',
      click: '/pet/presets/shiyi-click.png',
    },
  },
  {
    key: 'qiuqiu',
    name: '沈球球',
    desc: '长毛银渐层，平时是插画形态，点她会炸毛、睡觉会躺平，都是真身出镜。',
    size: 100,
    images: {
      idle: '/pet/presets/qiuqiu-idle.png',
      sleep: '/pet/presets/qiuqiu-sleep.png',
      click: '/pet/presets/qiuqiu-click.png',
    },
  },
];

const stateLabels: Record<string, string> = {
  idle: '溜达', eat: '干饭', sleep: '睡觉', drag: '被拎', click: '被点',
};
---

<Base title="桌宠领养处 · 小完能实验室" description="选一只咪或上传照片，分状态抠图，领养一只全站陪逛的桌宠。">
  <a class="back-link" href="/tools/"><span aria-hidden="true">←</span> 返回猫爪工具箱</a>

  <header class="tool-heading">
    <div>
      <p class="eyebrow">Adoption center · site pet</p>
      <h1>桌宠领养处</h1>
      <p>领一只现成的咪，或者用自己的照片建档：给每个状态传一张照片，模型负责脱背景。领养之后，它会在本站每一页陪你溜达、干饭、打盹。</p>
    </div>
    <span class="status-pill">GEAR READY</span>
  </header>

  <section class="preset-section">
    <div class="section-head"><h2>现成的咪</h2><span>RESIDENT CATS</span></div>
    <div class="preset-grid">
      {presets.map((preset) => (
        <article class="card preset-card">
          <div class="preset-main">
            <img src={preset.images.idle} alt={`${preset.name}立绘`} loading="lazy" />
            <div>
              <h3>{preset.name}</h3>
              <p>{preset.desc}</p>
              <div class="preset-actions">
                <button class="btn" type="button" data-adopt-preset={preset.key}>
                  领养{preset.name.slice(1)} <i class="paw-i" aria-hidden="true"></i>
                </button>
                <button class="preset-toggle" type="button" aria-expanded="false">
                  它会些啥 <i aria-hidden="true">▾</i>
                </button>
              </div>
            </div>
          </div>
          <div class="preset-states" hidden>
            {slots.map((slot) => {
              const src = preset.images[slot.key];
              return (
                <figure class:list={['state-chip', { missing: !src }]}>
                  {src
                    ? <img src={src} alt={`${preset.name}的${stateLabels[slot.key]}状态`} loading="lazy" />
                    : <span class="state-empty" aria-hidden="true">－</span>}
                  <figcaption>
                    {stateLabels[slot.key]}
                    {!src && <small>回退溜达图</small>}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script type="application/json" id="preset-json" set:html={JSON.stringify(presets)} />

  <section class="tool-workspace">
    <div class="workspace-bar">
      <span>CUSTOM PET · GEAR 02</span>
      <div><i></i><i></i><i></i></div>
    </div>

    <div class="custom-body">
      <div class="panel-label"><span>01</span> 自己建档：给每个状态投喂照片（自动抠图）</div>
      <div class="slot-grid">
        {slots.map((slot) => (
          <div class="slot" data-slot={slot.key} data-required={slot.required ? '1' : ''}>
            <input type="file" accept="image/png,image/jpeg,image/webp" hidden />
            <button class="slot-drop" type="button">
              <img alt="" hidden />
              <span class="slot-plus" aria-hidden="true">＋</span>
            </button>
            <strong>{slot.label}{slot.required && <em> *</em>}</strong>
            <small class="slot-status">{slot.hint}</small>
            <button class="slot-clear" type="button" hidden aria-label={`清除${slot.label}`}>✕</button>
          </div>
        ))}
      </div>

      <div class="panel-label second"><span>02</span> 办领养手续</div>
      <div class="adopt-form">
        <label>它叫什么名字？
          <input type="text" id="pet-name" maxlength="12" placeholder="比如：球球二号" />
        </label>
        <label>个头
          <input type="range" id="pet-size" min="64" max="160" value="96" step="8" />
        </label>
        <button class="btn btn-accent" id="adopt" type="button" disabled>领养！<i class="paw-i" aria-hidden="true"></i></button>
        <span id="status" class="process-status" aria-live="polite">先给「站立」传一张照片</span>
      </div>
    </div>
  </section>

  <aside class="current-pet" id="current-pet" hidden>
    <div>
      <strong>在住居民：<span id="current-name"></span></strong>
      <p>它正在本站的各个页面溜达。点它有惊喜，拖它会被抗议。</p>
    </div>
    <button class="btn btn-secondary" id="release" type="button">送它回老家</button>
  </aside>

  <div class="tool-notes">
    <div><span>◈</span><p><strong>不会留存</strong>照片只用于本次抠图，宠物存在你自己的浏览器里，我们这边什么都没有。</p></div>
    <div><span>🐾</span><p><strong>拍摄建议</strong>主体和背景反差越大抠得越干净。白猫贴白墙属于地狱难度，球球已经验证过了。</p></div>
    <div><span>⌁</span><p><strong>想带走？</strong>去小鱼干补给站下载 desktop-pet Skill，让你的 Agent 帮你做独立版桌宠。</p></div>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE_URL || '/api';
    const PET_KEY = 'xwn-pet';

    // 预设档案与卡片渲染同源（页面里的 JSON script），避免两处维护
    const PRESETS: Record<string, any> = Object.fromEntries(
      JSON.parse(document.getElementById('preset-json')!.textContent!).map((p: any) => [p.key, p])
    );

    // 「它会些啥」展开/收起
    document.querySelectorAll<HTMLButtonElement>('.preset-toggle').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const states = toggle.closest('.preset-card')!.querySelector('.preset-states') as HTMLElement;
        const open = states.hidden;
        states.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.classList.toggle('open', open);
      });
    });

    const statusEl = document.getElementById('status') as HTMLSpanElement;
    const adoptBtn = document.getElementById('adopt') as HTMLButtonElement;
    const petName = document.getElementById('pet-name') as HTMLInputElement;
    const petSize = document.getElementById('pet-size') as HTMLInputElement;
    const currentPet = document.getElementById('current-pet') as HTMLElement;
    const currentName = document.getElementById('current-name') as HTMLSpanElement;
    const releaseBtn = document.getElementById('release') as HTMLButtonElement;

    const images: Record<string, string> = {};

    const setStatus = (text: string, state?: string) => {
      statusEl.textContent = text;
      if (state) statusEl.dataset.state = state;
      else delete statusEl.dataset.state;
    };

    const refreshCurrent = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(PET_KEY) || 'null');
        if (saved?.images?.idle || saved?.image) {
          currentPet.hidden = false;
          currentName.textContent = saved.name || '小伙伴';
        } else currentPet.hidden = true;
      } catch { currentPet.hidden = true; }
    };
    refreshCurrent();

    const adopt = (record: any) => {
      try {
        localStorage.setItem(PET_KEY, JSON.stringify(record));
      } catch {
        setStatus('图太大存不下，换张小点的试试', 'error');
        return false;
      }
      refreshCurrent();
      (window as any).XwnPet?.unmount?.();
      if ((window as any).XwnPet) (window as any).XwnPet.mount(record);
      else {
        const s = document.createElement('script');
        s.src = '/pet/xwn-pet.js?v=3'; // 与 Base.astro loader 的版本号保持一致
        s.onload = () => (window as any).XwnPet.mount(record);
        document.body.appendChild(s);
      }
      return true;
    };

    // ---- 预设领养 ----
    document.querySelectorAll<HTMLButtonElement>('[data-adopt-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = PRESETS[btn.dataset.adoptPreset!];
        if (adopt({ ...preset, adoptedAt: Date.now() })) {
          setStatus(`${preset.name} 领养成功，已经开始溜达了！`, 'ready');
        }
      });
    });

    // ---- 自定义槽位 ----
    const updateAdoptState = () => {
      adoptBtn.disabled = !images.idle;
      if (images.idle) setStatus('材料齐了，可以办手续', 'ready');
    };

    document.querySelectorAll<HTMLDivElement>('.slot').forEach((slot) => {
      const key = slot.dataset.slot!;
      const input = slot.querySelector('input') as HTMLInputElement;
      const drop = slot.querySelector('.slot-drop') as HTMLButtonElement;
      const img = slot.querySelector('img') as HTMLImageElement;
      const plus = slot.querySelector('.slot-plus') as HTMLSpanElement;
      const status = slot.querySelector('.slot-status') as HTMLElement;
      const clear = slot.querySelector('.slot-clear') as HTMLButtonElement;
      const hint = status.textContent;

      drop.addEventListener('click', () => input.click());
      clear.addEventListener('click', () => {
        delete images[key];
        img.hidden = true;
        plus.hidden = false;
        clear.hidden = true;
        status.textContent = hint;
        slot.classList.remove('done');
        updateAdoptState();
      });

      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        status.textContent = '抠图中…';
        slot.classList.add('busy');
        try {
          // 桌宠最终只要 512px，大图先在浏览器里压小再上传，又快又不会撞 10MB 限制
          let payload: Blob = file;
          if (file.size > 2 * 1024 * 1024) payload = await shrinkImage(file, 1600);
          const form = new FormData();
          form.append('file', payload, 'photo.jpg');
          const response = await fetch(`${API}/v1/remove-background`, { method: 'POST', body: form });
          if (!response.ok) { status.textContent = response.status === 413 ? '图太大了' : `失败 (${response.status})`; return; }
          const dataUrl = await downscale(await response.blob(), 512);
          images[key] = dataUrl;
          img.src = dataUrl;
          img.hidden = false;
          plus.hidden = true;
          clear.hidden = false;
          status.textContent = '已入档';
          slot.classList.add('done');
          updateAdoptState();
        } catch {
          status.textContent = '后端睡着了';
        } finally {
          slot.classList.remove('busy');
          input.value = '';
        }
      });
    });

    adoptBtn.addEventListener('click', () => {
      if (!images.idle) return;
      const record = {
        name: (petName.value || '').trim() || '小伙伴',
        size: Number(petSize.value) || 96,
        images: { ...images },
        adoptedAt: Date.now(),
      };
      if (adopt(record)) setStatus(`${record.name} 领养成功，已经开始溜达了！`, 'ready');
    });

    releaseBtn.addEventListener('click', () => {
      localStorage.removeItem(PET_KEY);
      (window as any).XwnPet?.unmount?.();
      refreshCurrent();
      setStatus('送走了，常回家看看');
    });

    async function shrinkImage(file: Blob, maxSide: number): Promise<Blob> {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, maxSide / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      return await new Promise((resolve) => canvas.toBlob((b) => resolve(b!), 'image/jpeg', 0.9));
    }

    async function downscale(blob: Blob, max: number): Promise<string> {
      const bitmap = await createImageBitmap(blob);
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/png');
    }
  </script>

  <style>
    .tool-heading {
      margin-bottom: 38px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
    }
    .tool-heading h1 { margin: 0; font-family: var(--font-serif); font-size: clamp(36px, 5.5vw, 58px); line-height: 1.12; }
    .tool-heading p:not(.eyebrow) { margin: 16px 0 0; color: var(--ink-soft); max-width: 620px; }
    .tool-heading .status-pill { transform: rotate(4deg); }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
      padding-bottom: 12px;
      border-bottom: 2px solid var(--ink);
    }
    .section-head h2 { margin: 0; font-family: var(--font-serif); font-size: 24px; }
    .section-head span { font: 700 9px/1 var(--font-mono); letter-spacing: .22em; color: var(--ink-soft); }

    .preset-section { margin-bottom: 40px; }
    .preset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
    .preset-card { padding: 22px; }
    .preset-main { display: flex; gap: 20px; align-items: center; }
    .preset-main > img { width: 110px; height: 110px; object-fit: contain; flex: 0 0 auto; }
    .preset-card h3 { margin: 0 0 6px; }
    .preset-card p { margin: 0 0 14px; }
    .preset-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

    .preset-toggle {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 2px;
      border: 0;
      background: none;
      color: var(--teal);
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      border-bottom: 2px dashed var(--teal);
    }
    .preset-toggle i { font-style: normal; transition: transform 160ms ease; }
    .preset-toggle.open i { transform: rotate(180deg); }

    .preset-states {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 2px dashed var(--line);
    }
    .state-chip { margin: 0; display: grid; gap: 6px; justify-items: center; }
    .state-chip img,
    .state-empty {
      width: 100%;
      aspect-ratio: 1;
      object-fit: contain;
      border: 2px solid var(--teal);
      border-radius: var(--radius-sm);
      background:
        linear-gradient(45deg, rgba(35,50,77,.03) 25%, transparent 25%, transparent 75%, rgba(35,50,77,.03) 75%),
        var(--paper);
      background-size: 14px 14px;
      padding: 4px;
    }
    .state-empty { display: grid; place-items: center; border: 2px dashed var(--line); color: var(--ink-faint); }
    .state-chip figcaption { font-size: 11px; font-weight: 700; font-family: var(--font-serif); text-align: center; }
    .state-chip figcaption small { display: block; margin-top: 2px; color: var(--ink-faint); font-size: 9.5px; font-weight: 400; }
    .state-chip.missing figcaption { color: var(--ink-faint); }

    .tool-workspace {
      overflow: hidden;
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      background: var(--card);
      box-shadow: 8px 8px 0 rgba(35, 50, 77, 0.14);
    }
    .workspace-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 22px;
      color: var(--ink-soft);
      border-bottom: 2px solid var(--ink);
      background: repeating-linear-gradient(-45deg, transparent 0 8px, rgba(35, 50, 77, 0.04) 8px 16px);
      font: 700 9px/1 var(--font-mono);
      letter-spacing: .16em;
    }
    .workspace-bar div { display: flex; gap: 6px; }
    .workspace-bar i { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
    .workspace-bar i:first-child { background: var(--teal); }

    .custom-body { padding: 26px; }
    .panel-label { margin-bottom: 18px; color: var(--ink); font-size: 13px; font-weight: 700; font-family: var(--font-serif); }
    .panel-label.second { margin-top: 30px; }
    .panel-label span { margin-right: 8px; color: var(--red); font: 700 10px/1 var(--font-mono); }

    .slot-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
    .slot { position: relative; display: grid; gap: 6px; justify-items: center; text-align: center; }
    .slot strong { font-size: 12.5px; font-family: var(--font-serif); }
    .slot strong em { color: var(--red); font-style: normal; }
    .slot-status { color: var(--ink-faint); font-size: 10.5px; line-height: 1.5; min-height: 2.6em; }
    .slot.done .slot-status { color: var(--teal); font-weight: 700; }
    .slot.busy .slot-status { color: var(--gold); }

    .slot-drop {
      width: 100%;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 2px dashed var(--ink-faint);
      border-radius: var(--radius-sm);
      background:
        linear-gradient(45deg, rgba(35,50,77,.03) 25%, transparent 25%, transparent 75%, rgba(35,50,77,.03) 75%),
        var(--paper);
      background-size: 16px 16px;
      cursor: pointer;
      transition: border-color 160ms ease;
      padding: 6px;
    }
    .slot-drop:hover { border-color: var(--red); }
    .slot.done .slot-drop { border-style: solid; border-color: var(--teal); }
    .slot-drop img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .slot-plus { color: var(--ink-faint); font-size: 26px; }

    .slot-clear {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 24px;
      height: 24px;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--card);
      color: var(--red);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
    }

    .adopt-form { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto; gap: 18px; align-items: end; }
    .adopt-form label { display: grid; gap: 6px; color: var(--ink); font-size: 13px; font-weight: 700; font-family: var(--font-serif); }
    .adopt-form input[type="text"] { padding: 10px 12px; border: 2px solid var(--ink); border-radius: var(--radius); background: var(--card); font-size: 14px; }
    .adopt-form input[type="range"] { accent-color: var(--red); }
    .adopt-form .process-status { grid-column: 1 / -1; }

    .process-status { color: var(--ink-soft); font-size: 12.5px; }
    .process-status::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--ink-faint); }
    .process-status[data-state="ready"] { color: var(--teal); }
    .process-status[data-state="ready"]::before { background: var(--teal); }
    .process-status[data-state="error"] { color: var(--red); }
    .process-status[data-state="error"]::before { background: var(--red); }

    .current-pet {
      margin-top: 22px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border: 2px solid var(--teal);
      border-radius: var(--radius-sm);
      background: rgba(30, 127, 116, 0.05);
    }
    .current-pet strong { font-family: var(--font-serif); font-size: 15px; }
    .current-pet p { margin: 4px 0 0; color: var(--ink-soft); font-size: 12.5px; }

    .tool-notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
    .tool-notes > div { padding: 16px 18px; display: flex; gap: 12px; border: 2px dashed var(--line); border-radius: var(--radius-sm); }
    .tool-notes span { color: var(--red); }
    .tool-notes p { margin: 0; color: var(--ink-soft); font-size: 11.5px; line-height: 1.7; }
    .tool-notes strong { display: block; margin-bottom: 2px; color: var(--ink); font-size: 12.5px; }

    @media (max-width: 860px) {
      .preset-grid { grid-template-columns: 1fr; }
      .slot-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .adopt-form { grid-template-columns: 1fr; align-items: stretch; }
      .tool-notes { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .tool-heading { align-items: flex-start; flex-direction: column; }
      .slot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .preset-main { flex-direction: column; align-items: flex-start; }
      .preset-states { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .current-pet { flex-direction: column; align-items: flex-start; }
      .custom-body { padding: 18px; }
    }
  </style>
</Base>
