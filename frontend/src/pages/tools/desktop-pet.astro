---
import Base from '../../layouts/Base.astro';
---

<Base title="桌宠领养处 · 小完能实验室" description="上传照片，抠图领养，让它在本站每一页陪你溜达。">
  <a class="back-link" href="/tools/"><span aria-hidden="true">←</span> 返回猫爪工具箱</a>

  <header class="tool-heading">
    <div>
      <p class="eyebrow">Adoption center · site pet</p>
      <h1>桌宠领养处</h1>
      <p>上传一张照片，模型帮它脱掉背景，起个名字就能领养。领养之后，它会在本站的每一页陪你溜达。</p>
    </div>
    <span class="status-pill">GEAR READY</span>
  </header>

  <section class="tool-workspace">
    <div class="workspace-bar">
      <span>DESKTOP PET · GEAR 02</span>
      <div><i></i><i></i><i></i></div>
    </div>

    <div class="workspace-grid">
      <div class="input-panel">
        <div class="panel-label"><span>01</span> 挑一张照片</div>
        <input type="file" id="file" accept="image/png,image/jpeg,image/webp" hidden />
        <label class="dropzone" id="dropzone" for="file">
          <span class="upload-glyph" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong id="file-name">把照片叼到这里来</strong>
          <span id="file-hint">或者点击选择 JPEG / PNG / WebP，主体清晰效果最好</span>
          <span class="choose-file">选择照片</span>
          <div id="source-preview" class="source-preview" aria-hidden="true"></div>
        </label>
        <div class="action-row">
          <button class="btn" id="run" type="button">开始抠图 <span aria-hidden="true">→</span></button>
          <span id="status" class="process-status" aria-live="polite">等投喂照片</span>
        </div>
      </div>

      <div class="output-panel">
        <div class="panel-label"><span>02</span> 领养手续</div>
        <div id="stage" class="pet-stage">
          <div class="empty-result" id="stage-empty">
            <span aria-hidden="true"><i class="paw-i"></i></span>
            <strong>抠好的小家伙会站在这里</strong>
            <p>先在左边投喂一张照片</p>
          </div>
          <img id="pet-preview" class="pet-preview" alt="待领养的桌宠预览" hidden />
        </div>
        <div class="adopt-form" id="adopt-form" hidden>
          <label>它叫什么名字？
            <input type="text" id="pet-name" maxlength="12" placeholder="比如：球球二号" />
          </label>
          <label>个头
            <input type="range" id="pet-size" min="64" max="160" value="96" step="8" />
          </label>
          <button class="btn btn-accent" id="adopt" type="button">领养！<i class="paw-i" aria-hidden="true"></i></button>
        </div>
      </div>
    </div>
  </section>

  <aside class="current-pet" id="current-pet" hidden>
    <div>
      <strong>在住居民：<span id="current-name"></span></strong>
      <p>它正在本站的各个页面溜达。点它有惊喜，拖它会被抗议。</p>
    </div>
    <button class="btn btn-secondary" id="release" type="button">送它回老家</button>
  </aside>

  <div class="tool-notes">
    <div><span>◈</span><p><strong>不会留存</strong>照片只用于本次抠图，宠物存在你自己的浏览器里，我们这边什么都没有。</p></div>
    <div><span>🐾</span><p><strong>行为手册</strong>它会溜达、打盹、被点了冒爪印，太久不理它还会喊你。</p></div>
    <div><span>⌁</span><p><strong>想带走？</strong>去小鱼干补给站下载 desktop-pet Skill，让你的 Agent 帮你做一个独立版桌宠。</p></div>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE_URL || '/api';
    const PET_KEY = 'xwn-pet';

    const fileInput = document.getElementById('file') as HTMLInputElement;
    const runBtn = document.getElementById('run') as HTMLButtonElement;
    const statusEl = document.getElementById('status') as HTMLSpanElement;
    const dropzone = document.getElementById('dropzone') as HTMLLabelElement;
    const fileName = document.getElementById('file-name') as HTMLSpanElement;
    const fileHint = document.getElementById('file-hint') as HTMLSpanElement;
    const sourcePreview = document.getElementById('source-preview') as HTMLDivElement;
    const stageEmpty = document.getElementById('stage-empty') as HTMLDivElement;
    const petPreview = document.getElementById('pet-preview') as HTMLImageElement;
    const adoptForm = document.getElementById('adopt-form') as HTMLDivElement;
    const petName = document.getElementById('pet-name') as HTMLInputElement;
    const petSize = document.getElementById('pet-size') as HTMLInputElement;
    const adoptBtn = document.getElementById('adopt') as HTMLButtonElement;
    const currentPet = document.getElementById('current-pet') as HTMLElement;
    const currentName = document.getElementById('current-name') as HTMLSpanElement;
    const releaseBtn = document.getElementById('release') as HTMLButtonElement;

    let selectedFile: File | undefined;
    let cutoutDataUrl: string | undefined;

    const setStatus = (text: string, state?: string) => {
      statusEl.textContent = text;
      if (state) statusEl.dataset.state = state;
      else delete statusEl.dataset.state;
    };

    const refreshCurrent = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(PET_KEY) || 'null');
        if (saved?.image) {
          currentPet.hidden = false;
          currentName.textContent = saved.name || '小伙伴';
        } else {
          currentPet.hidden = true;
        }
      } catch { currentPet.hidden = true; }
    };
    refreshCurrent();

    const showFile = (file: File) => {
      selectedFile = file;
      const url = URL.createObjectURL(file);
      sourcePreview.style.backgroundImage = `url("${url}")`;
      sourcePreview.classList.add('visible');
      fileName.textContent = file.name;
      fileHint.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB · 点击可重新选择`;
      setStatus('照片就位，可以开抠', 'ready');
    };

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) showFile(file);
    });
    ['dragenter', 'dragover'].forEach((n) => dropzone.addEventListener(n, (e) => { e.preventDefault(); dropzone.classList.add('dragging'); }));
    ['dragleave', 'drop'].forEach((n) => dropzone.addEventListener(n, (e) => { e.preventDefault(); dropzone.classList.remove('dragging'); }));
    dropzone.addEventListener('drop', (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) showFile(file);
    });

    runBtn.addEventListener('click', async () => {
      if (!selectedFile) { setStatus('先投喂一张照片嘛', 'error'); return; }
      setStatus('施展抠抠神功…', 'running');
      runBtn.disabled = true;
      try {
        const form = new FormData();
        form.append('file', selectedFile);
        const response = await fetch(`${API}/v1/remove-background`, { method: 'POST', body: form });
        if (!response.ok) {
          setStatus(`抠图失败 (${response.status})`, 'error');
          return;
        }
        const blob = await response.blob();
        // 压到 512px 内再存，避免撑爆 localStorage
        cutoutDataUrl = await downscale(blob, 512);
        petPreview.src = cutoutDataUrl;
        petPreview.hidden = false;
        stageEmpty.hidden = true;
        adoptForm.hidden = false;
        setStatus('抠好了！右边办领养手续', 'ready');
      } catch (err) {
        setStatus('后端睡着了，没叫醒', 'error');
        console.error(err);
      } finally {
        runBtn.disabled = false;
      }
    });

    adoptBtn.addEventListener('click', () => {
      if (!cutoutDataUrl) return;
      const record = {
        image: cutoutDataUrl,
        name: (petName.value || '').trim() || '小伙伴',
        size: Number(petSize.value) || 96,
        adoptedAt: Date.now(),
      };
      try {
        localStorage.setItem(PET_KEY, JSON.stringify(record));
      } catch {
        setStatus('图太大存不下，换张小点的试试', 'error');
        return;
      }
      setStatus(`${record.name} 领养成功！`, 'ready');
      refreshCurrent();
      // 立刻上岗
      (window as any).XwnPet?.unmount?.();
      (window as any).XwnPet?.mount?.(record);
    });

    releaseBtn.addEventListener('click', () => {
      localStorage.removeItem(PET_KEY);
      (window as any).XwnPet?.unmount?.();
      refreshCurrent();
      setStatus('送走了，常回家看看');
    });

    async function downscale(blob: Blob, max: number): Promise<string> {
      const bitmap = await createImageBitmap(blob);
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/png');
    }
  </script>

  <style>
    .tool-heading {
      margin-bottom: 38px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
    }
    .tool-heading h1 { margin: 0; font-family: var(--font-serif); font-size: clamp(36px, 5.5vw, 58px); line-height: 1.12; }
    .tool-heading p:not(.eyebrow) { margin: 16px 0 0; color: var(--ink-soft); max-width: 560px; }
    .tool-heading .status-pill { transform: rotate(4deg); }

    .tool-workspace {
      overflow: hidden;
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      background: var(--card);
      box-shadow: 8px 8px 0 rgba(35, 50, 77, 0.14);
    }
    .workspace-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 22px;
      color: var(--ink-soft);
      border-bottom: 2px solid var(--ink);
      background: repeating-linear-gradient(-45deg, transparent 0 8px, rgba(35, 50, 77, 0.04) 8px 16px);
      font: 700 9px/1 var(--font-mono);
      letter-spacing: .16em;
    }
    .workspace-bar div { display: flex; gap: 6px; }
    .workspace-bar i { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
    .workspace-bar i:first-child { background: var(--teal); }

    .workspace-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .input-panel, .output-panel { min-width: 0; padding: 26px; }
    .input-panel { border-right: 2px dashed var(--line); }
    .panel-label { margin-bottom: 16px; color: var(--ink); font-size: 13px; font-weight: 700; font-family: var(--font-serif); }
    .panel-label span { margin-right: 8px; color: var(--red); font: 700 10px/1 var(--font-mono); }

    .dropzone,
    .pet-stage {
      position: relative;
      min-height: 330px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      border: 2px dashed var(--ink-faint);
      border-radius: var(--radius-sm);
      background:
        linear-gradient(45deg, rgba(35,50,77,.03) 25%, transparent 25%, transparent 75%, rgba(35,50,77,.03) 75%),
        linear-gradient(45deg, rgba(35,50,77,.03) 25%, transparent 25%, transparent 75%, rgba(35,50,77,.03) 75%),
        var(--paper);
      background-position: 0 0, 10px 10px;
      background-size: 20px 20px;
    }
    .dropzone { cursor: pointer; transition: border-color 180ms ease, background 180ms ease; }
    .dropzone:hover, .dropzone.dragging { border-color: var(--red); background-color: rgba(217, 79, 48, .045); }
    .dropzone > *:not(.source-preview) { position: relative; z-index: 2; }
    .upload-glyph { position: relative; width: 66px; height: 66px; margin-bottom: 20px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: var(--radius); background: var(--card); transform: rotate(-3deg); }
    .upload-glyph i { position: absolute; display: block; background: var(--ink); }
    .upload-glyph i:nth-child(1) { width: 2px; height: 25px; }
    .upload-glyph i:nth-child(2) { width: 13px; height: 2px; transform: translate(-4px, -8px) rotate(-40deg); }
    .upload-glyph i:nth-child(3) { width: 13px; height: 2px; transform: translate(4px, -8px) rotate(40deg); }
    .dropzone strong { max-width: 80%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; font-family: var(--font-serif); }
    .dropzone > span:not(.upload-glyph):not(.choose-file) { margin-top: 7px; color: var(--ink-soft); font-size: 12px; }
    .choose-file { margin-top: 18px; padding: 9px 14px; border: 2px solid var(--ink); border-radius: var(--radius); color: var(--ink); background: var(--card); font-size: 12px; font-weight: 700; box-shadow: 3px 3px 0 rgba(35,50,77,.16); }
    .source-preview { position: absolute; inset: 0; z-index: 1; opacity: 0; background-position: center; background-size: cover; transition: opacity 180ms ease; }
    .source-preview::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(245,239,226,.15), rgba(245,239,226,.85)); }
    .source-preview.visible { opacity: .55; }

    .action-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 18px; }
    .process-status { color: var(--ink-soft); font-size: 12.5px; }
    .process-status::before { content: ""; display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--ink-faint); }
    .process-status[data-state="ready"] { color: var(--teal); }
    .process-status[data-state="ready"]::before { background: var(--teal); }
    .process-status[data-state="running"] { color: var(--gold); }
    .process-status[data-state="running"]::before { background: var(--gold); animation: pulse 1s infinite; }
    .process-status[data-state="error"] { color: var(--red); }
    .process-status[data-state="error"]::before { background: var(--red); }

    .pet-preview { max-width: 78%; max-height: 240px; object-fit: contain; animation: bob 2.4s ease-in-out infinite; }
    @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

    .adopt-form { display: grid; gap: 14px; margin-top: 18px; }
    .adopt-form label { display: grid; gap: 6px; color: var(--ink); font-size: 13px; font-weight: 700; font-family: var(--font-serif); }
    .adopt-form input[type="text"] {
      padding: 10px 12px;
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      background: var(--card);
      font-size: 14px;
    }
    .adopt-form input[type="text"]:focus-visible { outline-offset: 0; }
    .adopt-form input[type="range"] { accent-color: var(--red); }

    .current-pet {
      margin-top: 22px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border: 2px solid var(--teal);
      border-radius: var(--radius-sm);
      background: rgba(30, 127, 116, 0.05);
    }
    .current-pet strong { font-family: var(--font-serif); font-size: 15px; }
    .current-pet p { margin: 4px 0 0; color: var(--ink-soft); font-size: 12.5px; }

    .tool-notes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 22px; }
    .tool-notes > div { padding: 16px 18px; display: flex; gap: 12px; border: 2px dashed var(--line); border-radius: var(--radius-sm); }
    .tool-notes span { color: var(--red); }
    .tool-notes p { margin: 0; color: var(--ink-soft); font-size: 11.5px; line-height: 1.7; }
    .tool-notes strong { display: block; margin-bottom: 2px; color: var(--ink); font-size: 12.5px; }

    @media (max-width: 860px) {
      .workspace-grid { grid-template-columns: 1fr; }
      .input-panel { border-right: 0; border-bottom: 2px dashed var(--line); }
      .tool-notes { grid-template-columns: 1fr; }
    }
    @media (max-width: 620px) {
      .tool-heading { align-items: flex-start; flex-direction: column; }
      .dropzone, .pet-stage { min-height: 280px; }
      .input-panel, .output-panel { padding: 18px; }
      .action-row { align-items: stretch; flex-direction: column; }
      .current-pet { flex-direction: column; align-items: flex-start; }
    }
  </style>
</Base>
