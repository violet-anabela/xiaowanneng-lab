---
import Base from '../../layouts/Base.astro';
---

<Base title="图片去背景">
  <a href="/tools">← 返回工具</a>
  <h1>图片去背景</h1>
  <p class="muted">
    上传图片，去除背景并返回透明 PNG。图片仅用于本次处理；结果响应不缓存（<code>Cache-Control: no-store</code>）。
  </p>

  <div class="prose">
    <input type="file" id="file" accept="image/png,image/jpeg,image/webp" />
    <div style="margin-top:12px; display:flex; gap:10px; align-items:center;">
      <button class="btn" id="run">去除背景</button>
      <span id="status" class="muted"></span>
    </div>
    <div id="result" style="margin-top:18px;"></div>
    <p class="muted" style="font-size:13px; margin-top:14px;">
      说明：本工具调用后端推理服务。服务可能处于冷启动，首次请求稍慢，请耐心等待。
      仅接受 JPEG / PNG / WebP，单文件 ≤ 10MB。
    </p>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE_URL || '/api';
    const fileInput = document.getElementById('file');
    const runBtn = document.getElementById('run');
    const statusEl = document.getElementById('status');
    const resultEl = document.getElementById('result');

    runBtn.addEventListener('click', async () => {
      const file = fileInput.files?.[0];
      if (!file) { statusEl.textContent = '请先选择图片'; return; }
      statusEl.textContent = '处理中…';
      resultEl.innerHTML = '';
      runBtn.disabled = true;
      try {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch(`${API}/v1/remove-background`, { method: 'POST', body: fd });
        if (!res.ok) {
          const msg = await res.text();
          statusEl.textContent = `失败 (${res.status})：${msg}`;
          return;
        }
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const img = document.createElement('img');
        img.src = url;
        img.style.maxWidth = '100%';
        img.style.border = '1px solid #e5e7eb';
        img.style.borderRadius = '8px';
        img.style.background = 'repeating-conic-gradient(#eee 0% 25%, #fff 0% 50%) 50% / 16px 16px';
        const a = document.createElement('a');
        a.href = url; a.download = 'remove-background.png'; a.className = 'btn';
        a.textContent = '下载 PNG';
        resultEl.appendChild(img);
        resultEl.appendChild(document.createElement('br'));
        resultEl.appendChild(a);
        statusEl.textContent = '完成';
      } catch (e) {
        statusEl.textContent = `错误：${e.message}`;
      } finally {
        runBtn.disabled = false;
      }
    });
  </script>
</Base>
