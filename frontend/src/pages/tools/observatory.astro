---
import Base from '../../layouts/Base.astro';
---

<Base title="中证1000观测站 · 小完能实验室" description="中证1000 的 Kronos 每日观测：模型路径推演、追加式账本与历史战绩。">
  <a class="back-link" href="/tools/"><span aria-hidden="true">←</span> 返回猫爪工具箱</a>

  <header class="page-heading">
    <p class="eyebrow">Observatory · daily watch</p>
    <h1>望远镜对准中证1000，<br /><span class="hl">每天掐爪一算</span></h1>
    <p>后端每个交易日开盘前自动观测：抓最新日线，让 Kronos 模型沙盘推演 30 条路径，记进一本只增不改的账。这页是观测记录，不是投资建议。</p>
  </header>

  <div id="obs-loading" class="obs-note">
    <i class="paw-i" aria-hidden="true"></i> 正在翻观测记录…
  </div>

  <div id="obs-empty" class="obs-note" hidden>
    <i class="paw-i" aria-hidden="true"></i> 观测员今天还没交作业（后端尚未生成数据，部署后第一次运行需要几分钟）。
  </div>

  <div id="obs-main" hidden>
    <section class="obs-latest">
      <div class="card obs-card">
        <span class="no no-red">今日观测</span>
        <span id="obs-signal" class="obs-stamp"></span>
        <dl class="obs-facts">
          <div><dt>基准交易日</dt><dd id="f-origin-date"></dd></div>
          <div><dt>基准收盘</dt><dd id="f-origin-close"></dd></div>
          <div><dt>下一交易日</dt><dd id="f-target-date"></dd></div>
          <div><dt>预测中位</dt><dd id="f-median"></dd></div>
          <div><dt>相对涨跌</dt><dd id="f-return"></dd></div>
          <div><dt>模型路径区间</dt><dd id="f-band"></dd></div>
          <div><dt>路径投票</dt><dd id="f-votes"></dd></div>
          <div><dt>模型方向一致度</dt><dd id="f-consensus"></dd></div>
        </dl>
        <small class="obs-updated" id="f-updated"></small>
      </div>

      <div class="card obs-card">
        <span class="no no-teal">历史战绩</span>
        <span id="obs-calibration" class="obs-calib-badge"></span>
        <dl class="obs-facts">
          <div><dt>已结算的次日预测</dt><dd id="s-count"></dd></div>
          <div><dt>方向准确率</dt><dd id="s-accuracy"></dd></div>
          <div><dt>点位平均绝对误差</dt><dd id="s-mae"></dd></div>
        </dl>
        <p class="obs-hint" id="s-hint"></p>
        <p class="obs-hint" id="s-calib-compare" hidden></p>
      </div>
    </section>

    <section class="obs-charts">
      <figure class="obs-polaroid obs-chart-card">
        <div class="obs-chart-wrap">
          <svg id="chart-latest" viewBox="0 0 640 360" role="img" aria-label="最新预测与路径区间图，可悬停查看具体日期和数值"></svg>
          <div class="obs-tooltip" id="chart-tooltip" role="tooltip"></div>
        </div>
        <figcaption>最新推演 · 中位数与路径区间（划过看具体数值）</figcaption>
      </figure>
      <figure class="obs-polaroid obs-chart-card">
        <div class="obs-chart-wrap">
          <svg id="chart-eval" viewBox="0 0 640 360" role="img" aria-label="历史预测与真实值对照图，可悬停查看具体日期和数值"></svg>
          <div class="obs-tooltip" id="chart-eval-tooltip" role="tooltip"></div>
        </div>
        <figcaption>复盘 · 预测与真实值对照（划过看具体数值）</figcaption>
      </figure>
    </section>

    <section class="obs-breakdown-wrap">
      <div class="section-head"><h2>分组战绩：把握大的时候准不准</h2><span>BY CONFIDENCE</span></div>
      <div class="table-scroll">
        <table class="obs-table">
          <thead>
            <tr><th>分组</th><th>已结算次数</th><th>方向准确率</th><th>点位平均绝对误差</th></tr>
          </thead>
          <tbody id="obs-breakdown-rows"></tbody>
        </table>
      </div>
      <p class="obs-hint">"高置信度"是模型 30 条路径里 ≥90% 一致同一个方向的情况；"不确定"是路径分歧较大、方向一致度没到 90% 的情况。样本数太少时百分比会大起大落，先看个大概。</p>
    </section>

    <section class="obs-table-wrap">
      <div class="section-head"><h2>未来十二个交易日的沙盘</h2><span>MODEL PATHS</span></div>
      <div class="table-scroll">
        <table class="obs-table">
          <thead>
            <tr><th>目标日</th><th>中位点位</th><th>相对涨跌</th><th>10%–90% 区间</th><th>上涨路径占比</th></tr>
          </thead>
          <tbody id="obs-rows"></tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="obs-memo">
    <span class="pin" aria-hidden="true"></span>
    <strong>球球的免责声明</strong>
    <p>路径占比是模型内部的一致程度，不是校准过的真实概率；30 条路径也只是有限采样。咪不炒股，这页只是我们围观模型掐算的手账，不构成任何投资建议。</p>
  </aside>

  <script>
    const API = import.meta.env.PUBLIC_API_BASE_URL || '/api';

    const $ = (id: string) => document.getElementById(id)!;

    const fmt = (n: number) => n.toLocaleString('zh-CN', { maximumFractionDigits: 2, minimumFractionDigits: 2 });
    const pct = (n: number) => `${(n * 100).toFixed(1)}%`;

    function parseCsv(text: string): Record<string, string>[] {
      const lines = text.trim().split('\n');
      const header = lines[0].split(',');
      return lines.slice(1).map((line) => {
        const cells = line.split(',');
        return Object.fromEntries(header.map((key, i) => [key, cells[i] ?? '']));
      });
    }

    const signalMap: Record<string, { text: string; cls: string }> = {
      'high-confidence up': { text: '高置信度 · 看涨', cls: 'up' },
      'high-confidence down': { text: '高置信度 · 看跌', cls: 'down' },
    };

    async function load() {
      try {
        const [statusRes, csvRes, barsRes] = await Promise.all([
          fetch(`${API}/v1/observatory/status.json`),
          fetch(`${API}/v1/observatory/forecasts.csv`),
          fetch(`${API}/v1/observatory/latest-bars.csv`),
        ]);
        if (!statusRes.ok || !csvRes.ok || !barsRes.ok) throw new Error('not ready');
        const status = await statusRes.json();
        const rows = parseCsv(await csvRes.text());
        const bars = parseCsv(await barsRes.text());
        render(status, rows, bars);
      } catch {
        $('obs-loading').hidden = true;
        $('obs-empty').hidden = false;
      }
    }

    function render(status: any, rows: Record<string, string>[], bars: Record<string, string>[]) {
      const latestOrigin = rows.reduce((max, r) => (r.origin_date > max ? r.origin_date : max), '');
      const latest = rows
        .filter((r) => r.origin_date === latestOrigin)
        .sort((a, b) => Number(a.horizon) - Number(b.horizon));
      if (!latest.length) throw new Error('empty ledger');
      const first = latest[0];

      const originClose = Number(first.origin_close);
      const median = Number(first.calibrated_median_close);
      const ret = median / originClose - 1;
      const pUp = Number(first.p_up);
      const upPaths = Math.round(pUp * Number(first.paths));
      const downPaths = Number(first.paths) - upPaths;
      const calibActive = first.calibration_active === 'True';
      const calibSamples = Number(first.calibration_samples || 0);
      const calibBias = Number(first.calibration_bias || 0);

      $('f-origin-date').textContent = first.origin_date;
      $('f-origin-close').textContent = fmt(originClose);
      $('f-target-date').textContent = first.target_date;
      $('f-median').textContent = fmt(median);
      const strength = Math.abs(ret) > 0.02 ? '强烈' : '温和';
      $('f-return').textContent = `${ret >= 0 ? '+' : ''}${(ret * 100).toFixed(2)}%（${strength}${ret >= 0 ? '上涨' : '下跌'}）`;
      $('f-return').className = ret >= 0 ? 'val-up' : 'val-down';
      $('f-band').textContent = `${fmt(Number(first.calibrated_p10_close))} ～ ${fmt(Number(first.calibrated_p90_close))}`;
      $('f-votes').textContent = `${upPaths} 涨 / ${downPaths} 跌（共 ${first.paths} 条）`;
      $('f-consensus').textContent = pct(Math.max(pUp, 1 - pUp));

      const sig = signalMap[first.signal];
      const stamp = $('obs-signal');
      stamp.textContent = sig ? sig.text : '方向不确定';
      stamp.classList.add(sig ? sig.cls : 'flat');

      $('f-updated').textContent = `账本更新于 ${String(status.updated_at).replace('T', ' ').slice(0, 16)} · 最新完整交易日 ${status.latest_completed_bar}`;

      // 反思环节状态徽章
      const calibBadge = $('obs-calibration');
      if (calibActive) {
        calibBadge.textContent = `🐾 已用 ${calibSamples} 个结算样本校正（历史偏差 ${calibBias >= 0 ? '+' : ''}${(calibBias * 100).toFixed(2)}%）`;
        calibBadge.className = 'obs-calib-badge active';
      } else {
        calibBadge.textContent = `样本不足（${calibSamples}/30），暂未启用统计校正`;
        calibBadge.className = 'obs-calib-badge';
      }

      // 历史战绩（只看 horizon=1 且已结算的）
      const settled = rows.filter((r) => r.horizon === '1' && r.actual_close);
      $('s-count').textContent = `${settled.length} 次`;
      if (settled.length) {
        // direction_correct 列因 np.where 里混了 np.nan 而被整体提升为 float64，
        // CSV 里存的其实是 "1.0"/"0.0" 而不是 "True"/"False"，两种都要认。
        const isTrue = (v: string) => v === 'True' || v === '1.0';
        const correct = settled.filter((r) => isTrue(r.direction_correct)).length;
        const mae = settled.reduce((sum, r) => sum + Number(r.absolute_error || 0), 0) / settled.length;
        $('s-accuracy').textContent = pct(correct / settled.length);
        $('s-mae').textContent = `${fmt(mae)} 点`;
        $('s-hint').textContent = settled.length < 20 ? '样本还很少，这些数字先看个热闹，别当真。' : '';

        // 校正前后对比（只有真正有 calibrated 数据、且和原始不同才展示，避免刷存在感）
        const withCalib = settled.filter((r) => r.calibrated_absolute_error);
        if (withCalib.length) {
          const calibCorrect = withCalib.filter((r) => isTrue(r.calibrated_direction_correct)).length;
          const calibMae = withCalib.reduce((sum, r) => sum + Number(r.calibrated_absolute_error || 0), 0) / withCalib.length;
          const rawMae = withCalib.reduce((sum, r) => sum + Number(r.absolute_error || 0), 0) / withCalib.length;
          if (Math.abs(calibMae - rawMae) > 0.01) {
            const compare = $('s-calib-compare');
            const better = calibMae < rawMae ? '更准了' : '暂时没帮上忙';
            compare.textContent = `校正前后对比：MAE ${fmt(rawMae)} → ${fmt(calibMae)}，方向准确率 ${pct(correct / settled.length)} → ${pct(calibCorrect / withCalib.length)}（${better}）`;
            compare.hidden = false;
          }
        }
      } else {
        $('s-accuracy').textContent = '—';
        $('s-mae').textContent = '—';
        $('s-hint').textContent = '第一批预测还没到结算日，战绩栏先空着。';
      }

      // 分组战绩：全部 / 高置信度 / 不确定——用后端已经算好的 signal 字段分组，
      // 不用自己再定一套置信度阈值。
      const breakdownBody = $('obs-breakdown-rows');
      breakdownBody.innerHTML = '';
      if (settled.length) {
        const isTrue = (v: string) => v === 'True' || v === '1.0';
        const groups: [string, Record<string, string>[]][] = [
          ['全部（通用效果）', settled],
          ['高置信度（≥90% 一致）', settled.filter((r) => r.signal === 'high-confidence up' || r.signal === 'high-confidence down')],
          ['不确定（分歧较大）', settled.filter((r) => r.signal === 'uncertain')],
        ];
        for (const [label, group] of groups) {
          const tr = document.createElement('tr');
          if (!group.length) {
            tr.innerHTML = `<td>${label}</td><td colspan="3">还没有这类样本</td>`;
          } else {
            const gCorrect = group.filter((r) => isTrue(r.direction_correct)).length;
            const gMae = group.reduce((sum, r) => sum + Number(r.absolute_error || 0), 0) / group.length;
            tr.innerHTML =
              `<td>${label}</td>` +
              `<td>${group.length} 次</td>` +
              `<td>${pct(gCorrect / group.length)}</td>` +
              `<td>${fmt(gMae)} 点</td>`;
          }
          breakdownBody.appendChild(tr);
        }
      } else {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td colspan="4">还没有结算数据，先攒着</td>`;
        breakdownBody.appendChild(tr);
      }

      // 未来路径表
      const tbody = $('obs-rows');
      tbody.innerHTML = '';
      for (const row of latest) {
        const rowMedian = Number(row.calibrated_median_close);
        const r = rowMedian / originClose - 1;
        const tr = document.createElement('tr');
        tr.innerHTML =
          `<td>${row.target_date}</td>` +
          `<td>${fmt(rowMedian)}</td>` +
          `<td class="${r >= 0 ? 'val-up' : 'val-down'}">${r >= 0 ? '+' : ''}${(r * 100).toFixed(2)}%</td>` +
          `<td>${fmt(Number(row.calibrated_p10_close))} ～ ${fmt(Number(row.calibrated_p90_close))}</td>` +
          `<td>${pct(Number(row.p_up))}</td>`;
        tbody.appendChild(tr);
      }

      const history = bars
        .slice(-90)
        .map((b) => ({ date: new Date(b.timestamps + 'T00:00:00'), close: Number(b.close) }));
      drawInteractiveChart(history, latest, originClose, first.origin_date);
      drawEvalChart(settled);

      $('obs-loading').hidden = true;
      $('obs-main').hidden = false;
    }

    // ---- 交互图表：原生 SVG + 悬停提示，配色取站点 CSS 变量，随主题自动匹配 ----
    function drawInteractiveChart(
      history: { date: Date; close: number }[],
      forecast: Record<string, string>[],
      originClose: number,
      originDateStr: string,
    ) {
      const svg = $('chart-latest') as unknown as SVGSVGElement;
      const tip = $('chart-tooltip');
      const NS = 'http://www.w3.org/2000/svg';
      const style = getComputedStyle(document.documentElement);
      const col = (name: string) => style.getPropertyValue(name).trim() || '#23324d';
      const ink = col('--ink');
      const inkSoft = col('--ink-soft');
      const inkFaint = col('--ink-faint');
      const red = col('--red');
      const teal = col('--teal');
      const gold = col('--gold');
      const line = col('--line');

      const calibActive = forecast[0]?.calibration_active === 'True';
      const fc = forecast.map((r) => ({
        date: new Date(r.target_date + 'T00:00:00'),
        median: Number(r.calibrated_median_close),
        p10: Number(r.calibrated_p10_close),
        p90: Number(r.calibrated_p90_close),
        rawMedian: Number(r.median_close),
        pUp: Number(r.p_up),
        actual: r.actual_close ? Number(r.actual_close) : null,
      }));
      const origin = { date: new Date(originDateStr + 'T00:00:00'), median: originClose, p10: originClose, p90: originClose, rawMedian: originClose, pUp: null as number | null, actual: originClose };
      const fca = [origin, ...fc];

      function el(name: string, attrs: Record<string, string | number> = {}) {
        const node = document.createElementNS(NS, name);
        for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
        return node;
      }

      function draw() {
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        const box = svg.getBoundingClientRect();
        const W = Math.max(320, box.width || 640);
        const H = Math.max(280, box.height || 360);
        const m = { t: 16, r: 16, b: 34, l: 58 };
        const iw = W - m.l - m.r;
        const ih = H - m.t - m.b;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

        const all = [...history, ...fc];
        const t0 = Math.min(...all.map((d) => +d.date));
        const t1 = Math.max(...all.map((d) => +d.date));
        const ys = [...history.map((d) => d.close), ...fc.flatMap((d) => [d.p10, d.p90])];
        const yMax = Math.max(...ys);
        const yMin = Math.min(...ys);
        const pad = (yMax - yMin) * 0.08 || 1;
        const x = (d: Date) => m.l + ((+d - t0) / (t1 - t0)) * iw;
        const y = (v: number) => m.t + ((yMax + pad - v) / (yMax - yMin + 2 * pad)) * ih;

        // 网格 + Y 轴刻度
        for (let i = 0; i <= 4; i++) {
          const yy = m.t + (ih * i) / 4;
          const val = yMax + pad - ((yMax - yMin + 2 * pad) * i) / 4;
          svg.append(el('line', { x1: m.l, x2: W - m.r, y1: yy, y2: yy, stroke: line, 'stroke-width': 1 }));
          const t = el('text', { x: m.l - 8, y: yy + 4, 'text-anchor': 'end', fill: inkFaint, 'font-size': 10 });
          t.textContent = Math.round(val).toLocaleString('zh-CN');
          svg.append(t);
        }
        // X 轴刻度
        const ticks = W < 480 ? 3 : 5;
        for (let i = 0; i < ticks; i++) {
          const tt = new Date(t0 + ((t1 - t0) * i) / (ticks - 1));
          const xx = x(tt);
          const t = el('text', {
            x: xx,
            y: H - 10,
            'text-anchor': i === 0 ? 'start' : i === ticks - 1 ? 'end' : 'middle',
            fill: inkFaint,
            'font-size': 10,
          });
          t.textContent = tt.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
          svg.append(t);
        }

        // 10%-90% 路径区间（含起点，衔接历史最后一点）
        const bandPath =
          fca.map((d, i) => `${i ? 'L' : 'M'}${x(d.date)},${y(d.p90)}`).join(' ') +
          ' ' +
          fca.slice().reverse().map((d) => `L${x(d.date)},${y(d.p10)}`).join(' ') +
          'Z';
        svg.append(el('path', { d: bandPath, fill: teal, opacity: 0.16, stroke: 'none' }));

        // 历史实线 + 预测中位数线
        const linePath = (arr: { date: Date }[], get: (d: any) => number) =>
          arr.map((d, i) => `${i ? 'L' : 'M'}${x(d.date)},${y(get(d))}`).join(' ');
        svg.append(el('path', { d: linePath(history, (d) => d.close), fill: 'none', stroke: ink, 'stroke-width': 2.2, 'stroke-linejoin': 'round' }));
        if (calibActive) {
          // 校正生效时画一条细的原始预测线做对照，直观看出反思环节的校正幅度。
          svg.append(el('path', { d: linePath(fca, (d) => d.rawMedian), fill: 'none', stroke: inkFaint, 'stroke-width': 1.3, 'stroke-dasharray': '4 3' }));
        }
        svg.append(el('path', { d: linePath(fca, (d) => d.median), fill: 'none', stroke: red, 'stroke-width': 2.4, 'stroke-linejoin': 'round' }));

        // 基准日虚线
        const bx = x(origin.date);
        svg.append(el('line', { x1: bx, x2: bx, y1: m.t, y2: H - m.b, stroke: gold, 'stroke-width': 1.2, 'stroke-dasharray': '5 4' }));

        // 悬停用的引导线 + 圆点
        const guide = el('line', { y1: m.t, y2: H - m.b, stroke: teal, 'stroke-width': 1, 'stroke-dasharray': '3 3', visibility: 'hidden' });
        const dot = el('circle', { r: 4, fill: red, stroke: '#fffdf7', 'stroke-width': 2, visibility: 'hidden' });
        svg.append(guide, dot);

        const hover = el('rect', { x: m.l, y: m.t, width: iw, height: ih, fill: 'transparent' });
        (hover as SVGElement).style.cursor = 'crosshair';
        hover.addEventListener('pointermove', (e: any) => {
          const r = svg.getBoundingClientRect();
          const px = ((e.clientX - r.left) * W) / r.width;
          const clamped = Math.max(m.l, Math.min(W - m.r, px));
          const targetDate = new Date(t0 + ((clamped - m.l) / iw) * (t1 - t0));
          const candidates = [
            ...history.map((d) => ({ ...d, kind: '历史' as const })),
            ...fc.map((d) => ({ ...d, kind: '预测' as const })),
          ];
          const nearest = candidates.reduce((a, b) => (Math.abs(+b.date - +targetDate) < Math.abs(+a.date - +targetDate) ? b : a));
          const value = nearest.kind === '历史' ? (nearest as any).close : (nearest as any).median;
          const xx = x(nearest.date);
          guide.setAttribute('x1', String(xx));
          guide.setAttribute('x2', String(xx));
          guide.setAttribute('visibility', 'visible');
          dot.setAttribute('cx', String(xx));
          dot.setAttribute('cy', String(y(value)));
          dot.setAttribute('visibility', 'visible');

          const dateLabel = nearest.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
          let body: string;
          if (nearest.kind === '历史') {
            body = `<div class="row"><span>收盘</span><b>${fmt((nearest as any).close)}</b></div>`;
          } else {
            const f = nearest as any;
            const r = f.median / originClose - 1;
            body =
              `<div class="row"><span>预测中位数</span><b>${fmt(f.median)}</b></div>` +
              (calibActive && Math.abs(f.rawMedian - f.median) > 0.01
                ? `<div class="row"><span>校正前原值</span><b>${fmt(f.rawMedian)}</b></div>`
                : '') +
              `<div class="row"><span>相对涨跌</span><b class="${r >= 0 ? 'val-up' : 'val-down'}">${r >= 0 ? '+' : ''}${(r * 100).toFixed(2)}%</b></div>` +
              `<div class="row"><span>路径区间</span><b>${fmt(f.p10)} ～ ${fmt(f.p90)}</b></div>` +
              (f.pUp != null ? `<div class="row"><span>上涨占比</span><b>${pct(f.pUp)}</b></div>` : '') +
              (f.actual != null ? `<div class="row"><span>真实收盘</span><b>${fmt(f.actual)}</b></div>` : '');
          }
          tip.innerHTML = `<strong>${dateLabel} · ${nearest.kind}</strong>${body}`;
          (tip as HTMLElement).style.display = 'block';
          const tipW = (tip as HTMLElement).offsetWidth;
          const tipH = (tip as HTMLElement).offsetHeight;
          const left = Math.min(box.width - tipW - 8, Math.max(8, e.clientX - r.left + 14));
          const top = Math.max(8, e.clientY - r.top - tipH - 12);
          (tip as HTMLElement).style.left = left + 'px';
          (tip as HTMLElement).style.top = top + 'px';
        });
        hover.addEventListener('pointerleave', () => {
          (tip as HTMLElement).style.display = 'none';
          guide.setAttribute('visibility', 'hidden');
          dot.setAttribute('visibility', 'hidden');
        });
        svg.append(hover);
      }

      draw();
      new ResizeObserver(draw).observe(svg.parentElement!);
    }

    // ---- 复盘图：已结算的预测 vs 真实值，跟上面那张交互图同一套做法 ----
    function drawEvalChart(settled: Record<string, string>[]) {
      const svg = $('chart-eval') as unknown as SVGSVGElement;
      const tip = $('chart-eval-tooltip');
      const NS = 'http://www.w3.org/2000/svg';
      const style = getComputedStyle(document.documentElement);
      const col = (name: string) => style.getPropertyValue(name).trim() || '#23324d';
      const ink = col('--ink');
      const inkSoft = col('--ink-soft');
      const inkFaint = col('--ink-faint');
      const red = col('--red');
      const teal = col('--teal');
      const line = col('--line');

      function el(name: string, attrs: Record<string, string | number> = {}) {
        const node = document.createElementNS(NS, name);
        for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
        return node;
      }

      function empty(msg: string) {
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        const box = svg.getBoundingClientRect();
        const W = Math.max(320, box.width || 640);
        const H = Math.max(280, box.height || 360);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        const t = el('text', { x: W / 2, y: H / 2, 'text-anchor': 'middle', fill: inkFaint, 'font-size': 13 });
        t.textContent = msg;
        svg.append(t);
      }

      if (!settled.length) {
        empty('还没有结算的预测，攒够数据就有图看了');
        return;
      }

      const points = settled
        .map((r) => ({
          date: new Date(r.target_date + 'T00:00:00'),
          median: Number(r.calibrated_median_close),
          p10: Number(r.calibrated_p10_close),
          p90: Number(r.calibrated_p90_close),
          actual: Number(r.actual_close),
        }))
        .sort((a, b) => +a.date - +b.date);

      function draw() {
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        const box = svg.getBoundingClientRect();
        const W = Math.max(320, box.width || 640);
        const H = Math.max(280, box.height || 360);
        const m = { t: 16, r: 16, b: 34, l: 58 };
        const iw = W - m.l - m.r;
        const ih = H - m.t - m.b;
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

        const t0 = +points[0].date;
        const t1 = +points[points.length - 1].date;
        const tSpan = t1 - t0 || 1;
        const single = points.length === 1;
        const ys = points.flatMap((d) => [d.p10, d.p90, d.median, d.actual]);
        const yMax = Math.max(...ys);
        const yMin = Math.min(...ys);
        const pad = (yMax - yMin) * 0.1 || 1;
        const x = (d: Date) => (single ? m.l + iw / 2 : m.l + ((+d - t0) / tSpan) * iw);
        const y = (v: number) => m.t + ((yMax + pad - v) / (yMax - yMin + 2 * pad)) * ih;

        for (let i = 0; i <= 4; i++) {
          const yy = m.t + (ih * i) / 4;
          const val = yMax + pad - ((yMax - yMin + 2 * pad) * i) / 4;
          svg.append(el('line', { x1: m.l, x2: W - m.r, y1: yy, y2: yy, stroke: line, 'stroke-width': 1 }));
          const t = el('text', { x: m.l - 8, y: yy + 4, 'text-anchor': 'end', fill: inkFaint, 'font-size': 10 });
          t.textContent = Math.round(val).toLocaleString('zh-CN');
          svg.append(t);
        }
        const ticks = Math.max(1, Math.min(points.length, W < 480 ? 3 : 6));
        for (let i = 0; i < ticks; i++) {
          const tt = new Date(t0 + (tSpan * i) / Math.max(1, ticks - 1));
          const xx = x(tt);
          const t = el('text', {
            x: xx,
            y: H - 10,
            'text-anchor': i === 0 ? 'start' : i === ticks - 1 ? 'end' : 'middle',
            fill: inkFaint,
            'font-size': 10,
          });
          t.textContent = tt.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
          svg.append(t);
        }

        if (!single) {
          const bandPath =
            points.map((d, i) => `${i ? 'L' : 'M'}${x(d.date)},${y(d.p90)}`).join(' ') +
            ' ' +
            points.slice().reverse().map((d) => `L${x(d.date)},${y(d.p10)}`).join(' ') +
            'Z';
          svg.append(el('path', { d: bandPath, fill: teal, opacity: 0.16, stroke: 'none' }));

          const linePath = (get: (d: (typeof points)[0]) => number) =>
            points.map((d, i) => `${i ? 'L' : 'M'}${x(d.date)},${y(get(d))}`).join(' ');
          svg.append(el('path', { d: linePath((d) => d.median), fill: 'none', stroke: red, 'stroke-width': 2.4, 'stroke-linejoin': 'round' }));
          svg.append(el('path', { d: linePath((d) => d.actual), fill: 'none', stroke: ink, 'stroke-width': 2.2, 'stroke-linejoin': 'round' }));
        }
        for (const d of points) {
          svg.append(el('circle', { cx: x(d.date), cy: y(d.actual), r: 3.4, fill: ink, stroke: '#fffdf7', 'stroke-width': 1.4 }));
          svg.append(el('circle', { cx: x(d.date), cy: y(d.median), r: 3.4, fill: red, stroke: '#fffdf7', 'stroke-width': 1.4 }));
        }

        // 图例
        const legend = [
          { c: ink, t: '真实收盘' },
          { c: red, t: '预测中位数' },
        ];
        legend.forEach((it, i) => {
          const ly = m.t + 4 + i * 15;
          svg.append(el('circle', { cx: m.l + 6, cy: ly, r: 4, fill: it.c }));
          const t = el('text', { x: m.l + 14, y: ly + 4, fill: inkSoft, 'font-size': 10 });
          t.textContent = it.t;
          svg.append(t);
        });

        const guide = el('line', { y1: m.t, y2: H - m.b, stroke: teal, 'stroke-width': 1, 'stroke-dasharray': '3 3', visibility: 'hidden' });
        svg.append(guide);

        const hover = el('rect', { x: m.l, y: m.t, width: iw, height: ih, fill: 'transparent' });
        (hover as SVGElement).style.cursor = 'crosshair';
        hover.addEventListener('pointermove', (e: any) => {
          const r = svg.getBoundingClientRect();
          const px = ((e.clientX - r.left) * W) / r.width;
          const clamped = Math.max(m.l, Math.min(W - m.r, px));
          const targetDate = new Date(t0 + ((clamped - m.l) / iw) * tSpan);
          const nearest = points.reduce((a, b) => (Math.abs(+b.date - +targetDate) < Math.abs(+a.date - +targetDate) ? b : a));
          const xx = x(nearest.date);
          guide.setAttribute('x1', String(xx));
          guide.setAttribute('x2', String(xx));
          guide.setAttribute('visibility', 'visible');

          const err = nearest.actual - nearest.median;
          const dateLabel = nearest.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
          const body =
            `<div class="row"><span>预测中位数</span><b>${fmt(nearest.median)}</b></div>` +
            `<div class="row"><span>真实收盘</span><b>${fmt(nearest.actual)}</b></div>` +
            `<div class="row"><span>误差</span><b class="${err >= 0 ? 'val-up' : 'val-down'}">${err >= 0 ? '+' : ''}${fmt(err)}</b></div>` +
            `<div class="row"><span>路径区间</span><b>${fmt(nearest.p10)} ～ ${fmt(nearest.p90)}</b></div>`;
          tip.innerHTML = `<strong>${dateLabel}</strong>${body}`;
          (tip as HTMLElement).style.display = 'block';
          const tipW = (tip as HTMLElement).offsetWidth;
          const tipH = (tip as HTMLElement).offsetHeight;
          const left = Math.min(box.width - tipW - 8, Math.max(8, e.clientX - r.left + 14));
          const top = Math.max(8, e.clientY - r.top - tipH - 12);
          (tip as HTMLElement).style.left = left + 'px';
          (tip as HTMLElement).style.top = top + 'px';
        });
        hover.addEventListener('pointerleave', () => {
          (tip as HTMLElement).style.display = 'none';
          guide.setAttribute('visibility', 'hidden');
        });
        svg.append(hover);
      }

      draw();
      new ResizeObserver(draw).observe(svg.parentElement!);
    }

    load();
  </script>

  <style>
