    .obs-chart-wrap { position: relative; width: 100%; height: 280px; }
    .obs-chart-wrap svg { display: block; width: 100%; height: 100%; overflow: visible; cursor: crosshair; }
    .obs-tooltip {
      position: absolute;
      display: none;
