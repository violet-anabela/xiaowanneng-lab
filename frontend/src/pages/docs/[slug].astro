---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/docs/*.md', { eager: true });
  return Object.keys(modules).map((path) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
  }));
}

const modules = import.meta.glob('../../content/docs/*.md', { eager: true });
const { slug } = Astro.params;
const entry = Object.entries(modules).find(
  ([path]) => path.split('/').pop().replace(/\.md$/, '') === slug
);
if (!entry) return Astro.redirect('/docs/');
const mod = entry[1];
const { Content } = mod;
---

<Base title={mod.frontmatter?.title ?? slug}>
  <a class="back-link" href="/docs/"><span aria-hidden="true">←</span> 返回巡逻手账</a>
  <div class="doc-sheet">
    <div class="doc-main">
      <span class="doc-stamp" aria-hidden="true">FIELD<br />NOTE</span>
      <article class="prose doc-article">
        <Content />
      </article>
    </div>
    <aside class="doc-toc-slot"></aside>
  </div>

  <script>
    // 长文章加一段"本页导航"侧栏：扫正文里的 h2，塞进旁边的 aside。
    // 章节太少（含没有 h2 的短文档）就不加，没必要；.doc-sheet 用 :has()
    // 检测 aside 里有没有内容来决定要不要切成侧栏布局，纯 CSS，不用额外加类。
    const article = document.querySelector('.doc-article');
    const slot = document.querySelector('.doc-toc-slot');
    const headings = article ? Array.from(article.querySelectorAll('h2')) : [];
    if (slot && headings.length >= 2) {
      const nav = document.createElement('nav');
      nav.className = 'doc-toc';
      nav.setAttribute('aria-label', '本页导航');

      const title = document.createElement('p');
      title.className = 'doc-toc-title';
      title.textContent = '本页导航';
      nav.appendChild(title);

      const ol = document.createElement('ol');
      headings.forEach((h) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        li.appendChild(a);
        ol.appendChild(li);
      });
      nav.appendChild(ol);

      slot.appendChild(nav);
    }
  </script>

  <style>
    .doc-sheet { max-width: 850px; margin: 0 auto; }
    .doc-main { position: relative; min-width: 0; }

    /* 侧栏里塞了导航时（.doc-toc-slot 有内容），切成两栏、导航放左边；没有就
       还是单栏居中，纯靠 :has() 判断，不用额外从脚本里切 class。
       注意不能给 align-items: start——侧栏格子要跟正文一样高，sticky 才有
       全程可以跟着滚动条走的空间，不然侧栏格子只有导航自己那么高，一下就到底了。 */
    @media (min-width: 760px) {
      .doc-sheet:has(.doc-toc) {
        max-width: 1120px;
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 32px;
      }
      .doc-toc-slot { order: -1; }
    }

    .doc-stamp {
      position: absolute;
      top: -22px;
      right: -14px;
      z-index: 1;
      width: 78px;
      height: 78px;
      display: grid;
      place-items: center;
      text-align: center;
      border: 3px double var(--teal);
      border-radius: 50%;
      color: var(--teal);
      background: rgba(255, 253, 247, 0.7);
      font: 800 10px/1.4 var(--font-mono);
      letter-spacing: 0.14em;
      transform: rotate(12deg);
      opacity: 0.85;
    }

    @media (max-width: 620px) {
      .doc-stamp { top: -18px; right: 0; width: 64px; height: 64px; font-size: 8.5px; }
    }
  </style>

  <style is:global>
    .doc-toc-slot:empty { display: none; }

    .doc-toc {
      margin: 28px 0 36px;
      padding: 16px 22px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 2px 2px 0 rgba(35, 50, 77, 0.08);
    }
    .doc-toc-title {
      margin: 0 0 10px;
      font: 700 12px/1.2 var(--font-mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .doc-toc ol {
      display: grid;
      gap: 7px;
      margin: 0;
      padding: 0;
      list-style: none;
      counter-reset: toc;
    }
    .doc-toc li { counter-increment: toc; }
    .doc-toc li::before {
      content: counter(toc) '. ';
      color: var(--ink-faint);
      font: 15px/1.4 var(--font-mono);
    }
    .doc-toc a {
      color: var(--ink-soft);
      text-decoration: none;
      font: 15px/1.4 var(--font-hand);
    }
    .doc-toc a:hover { color: var(--teal); text-decoration: underline; }

    /* 桌面下侧栏导航跟着滚动条走；窄屏（.doc-sheet 没切两栏时）就是正文里
       普通的一块，随文档往下走。
       站点顶部 .site-header 自己也是 sticky（global.css），实测高度 ~114px，
       导航的 sticky top 要让开这一块，不然会被吸顶的站点导航挡住/叠在一起。 */
    @media (min-width: 760px) {
      .doc-toc {
        position: sticky;
        top: 134px;
        margin: 0;
        max-height: calc(100vh - 134px - 24px);
        overflow-y: auto;
      }
    }
  </style>
</Base>
