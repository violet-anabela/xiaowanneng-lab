---
import Base from '../layouts/Base.astro';
import { tools } from '../data/tools';
import manifest from '../data/skills-manifest.json';

const availableTools = tools.filter((tool) => tool.status === 'available').length;
const skillCount = Object.keys(manifest.skills).length;
const documentModules = import.meta.glob('../content/docs/*.md');
const documentCount = Object.keys(documentModules).length;
const pad = (n: number) => n.toString().padStart(2, '0');
---

<Base title="小完能实验室" description="两只猫的探索手账：记录、造物、分享。">
  <section class="hero">
    <div class="hero-main">
      <p class="eyebrow">Feline expedition · est. 2026</p>
      <h1>两只猫的<br /><span class="hl">探索手账</span></h1>
      <p class="hero-copy">
        每一次技术探索都是一场小型远征：路线画在文档里，装备收在工具箱里，
        学会的本领打包成 Skill 送给同路人。
      </p>
      <div class="hero-actions">
        <a class="btn" href="/docs/">翻开手账 <span aria-hidden="true">→</span></a>
        <a class="btn btn-secondary" href="/tools/">查看装备</a>
        <a class="btn btn-secondary" href="/skills/">领取补给</a>
      </div>
      <div class="route" aria-label="探索的三个阶段">
        <div class="pt"><b>01</b><span>记录</span></div>
        <div class="leg"></div>
        <div class="pt"><b>02</b><span>造物</span></div>
        <div class="leg"></div>
        <div class="pt"><b>03</b><span>分享</span></div>
      </div>
    </div>

    <div class="polaroid-stack">
      <div class="polaroid">
        <span class="tape" aria-hidden="true"></span>
        <img src="/assets/lab-poster-xiaowanneng-colors.png" alt="小完能实验室的两只猫咪" width="1254" height="1254" />
        <span class="cap">考察队全体成员 · 出发前合影</span>
      </div>
      <div class="stamp" aria-hidden="true">XWN·LAB<br />APPROVED<br />★ 2026 ★</div>
      <div class="memo" aria-hidden="true">球球负责出主意，十一负责把挡板抠开。</div>
    </div>
  </section>

  <section class="trails">
    <div class="section-head">
      <h2>本次远征的三条路线</h2>
      <span>CHOOSE YOUR TRAIL</span>
    </div>
    <div class="card-grid">
      <a class="card trail-card" href="/docs/">
        <span class="no no-red">TRAIL 01</span>
        <h3>文档与复盘</h3>
        <p>把探索过程写下来：技术笔记、项目决策，以及值得记住的坑。</p>
        <span class="go go-red">沿着足迹走 →</span>
        <span class="count">{pad(documentCount)} 篇记录</span>
      </a>
      <a class="card trail-card" href="/tools/">
        <span class="no no-teal">TRAIL 02</span>
        <h3>轻量工具箱</h3>
        <p>图片去背景等实用装备。该在浏览器完成的就不上传，需要算力的交给后端。</p>
        <span class="go go-teal">打开背包 →</span>
        <span class="count">{pad(availableTools)} 件可用</span>
      </a>
      <a class="card trail-card" href="/skills/">
        <span class="no no-gold">TRAIL 03</span>
        <h3>可复用 Skills</h3>
        <p>下载、解压、安装，让任何兼容 Skill 的 Agent 直接获得新能力。</p>
        <span class="go go-gold">领取补给 →</span>
        <span class="count">{pad(skillCount)} 个补给包</span>
      </a>
    </div>
  </section>

  <section class="crew">
    <div class="section-head">
      <h2>考察队成员档案</h2>
      <span>MEET THE CREW</span>
    </div>
    <div class="crew-grid">
      <article class="card crew-card">
        <span class="no no-red">CAT.01</span>
        <div class="crew-top">
          <span class="crew-avatar"><img src="/assets/cat-shiyi.png" alt="奶牛猫沈十一" width="512" height="512" /></span>
          <div class="crew-id">
            <h3>沈十一</h3>
            <span class="crew-breed">奶牛猫 · 行动担当</span>
          </div>
        </div>
        <dl class="crew-file">
          <div><dt>主粮</dt><dd>干饭十级选手，饭点比闹钟准</dd></div>
          <div><dt>装备</dt><dd>激光笔、逗猫棒，见玩具走不动路</dd></div>
          <div><dt>绝活</dt><dd>抠开床挡板，钻进床底探险</dd></div>
          <div><dt>状态</dt><dd>粘妈妈中——打游戏也要挨着坐</dd></div>
        </dl>
        <p class="crew-quote">"挡板？不存在的。"</p>
      </article>

      <article class="card crew-card">
        <span class="no no-teal">CAT.02</span>
        <div class="crew-top">
          <span class="crew-avatar"><img src="/assets/cat-qiuqiu.png" alt="长毛银渐层沈球球" width="512" height="512" /></span>
          <div class="crew-id">
            <h3>沈球球</h3>
            <span class="crew-breed">长毛银渐层 · 军师担当</span>
          </div>
        </div>
        <dl class="crew-file">
          <div><dt>补给</dt><dd>零食爱好者，投喂永远不嫌多</dd></div>
          <div><dt>基地</dt><dd>航空箱常驻住户，进去就不想出来</dd></div>
          <div><dt>粘人</dt><dd>妈妈睡醒 &amp; 打工回家限定</dd></div>
          <div><dt>战术</dt><dd>蹲点等十一抠开挡板，跟进捡漏</dd></div>
        </dl>
        <p class="crew-quote">"等十一开门就行。"</p>
      </article>
    </div>
  </section>

  <aside class="archive-strip">
    <span class="archive-label">队内档案 / INTERNAL</span>
    <div class="archive-tabs">
      <a href="/development/frontend-service/">FRONTEND · 静态站</a>
      <a href="/development/backend-service/">BACKEND · 推理服务</a>
      <a href="/development/gateway-service/">GATEWAY · 反向代理</a>
    </div>
  </aside>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.95fr);
      align-items: center;
      gap: clamp(44px, 6vw, 72px);
      padding: 26px 0 30px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 38px;
    }

    .route { display: flex; align-items: center; margin-top: 56px; max-width: 480px; }
    .route .pt { text-align: center; }
    .route .pt b {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      margin: 0 auto;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--card);
      font: 700 15px/1 var(--font-mono);
    }
    .route .pt span { display: block; margin-top: 8px; font-size: 12.5px; color: var(--ink-soft); }
    .route .leg {
      flex: 1;
      height: 2px;
      margin: 0 8px 28px;
      background-image: linear-gradient(90deg, var(--ink) 55%, transparent 45%);
      background-size: 10px 2px;
    }

    .polaroid-stack { position: relative; justify-self: center; }
    .polaroid {
      width: min(360px, 82vw);
      padding: 14px 14px 54px;
      background: var(--card);
      border: 1px solid var(--line);
      box-shadow: 0 18px 44px rgba(35, 50, 77, 0.22);
      transform: rotate(2.5deg);
      position: relative;
    }
    .polaroid img { width: 100%; height: auto; display: block; }
    .polaroid .cap {
      position: absolute;
      bottom: 18px; left: 120px; right: 16px;
      text-align: right;
      font: 15px/1 var(--font-hand);
      color: var(--ink-soft);
    }
    .tape {
      position: absolute;
      top: -14px; left: 50%;
      width: 112px; height: 30px;
      background: var(--gold-soft);
      transform: translateX(-50%) rotate(-3deg);
      border-left: 1px dashed rgba(255, 255, 255, 0.65);
      border-right: 1px dashed rgba(255, 255, 255, 0.65);
    }
    .stamp {
      position: absolute;
      right: -26px; top: -28px;
      width: 108px; height: 108px;
      border: 3px double var(--red);
      border-radius: 50%;
      color: var(--red);
      display: grid;
      place-items: center;
      text-align: center;
      font: 800 11px/1.4 var(--font-mono);
      letter-spacing: 0.12em;
      transform: rotate(14deg);
      opacity: 0.82;
      background: rgba(255, 253, 247, 0.6);
    }
    .memo {
      position: absolute;
      bottom: -52px; left: -38px;
      width: 172px;
      padding: 14px;
      background: #fff9c9;
      box-shadow: 0 10px 24px rgba(35, 50, 77, 0.18);
      font: 13.5px/1.7 var(--font-hand);
      color: #6b5d1e;
      transform: rotate(-5deg);
    }

    .trails { margin-top: 100px; }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 34px;
      padding-bottom: 14px;
      border-bottom: 2px solid var(--ink);
    }
    .section-head h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(26px, 4vw, 34px); }
    .section-head span { font: 700 10px/1 var(--font-mono); letter-spacing: 0.25em; color: var(--ink-soft); white-space: nowrap; }

    .trail-card { display: flex; flex-direction: column; padding-top: 34px; }
    .no {
      position: absolute;
      top: -13px; left: 20px;
      padding: 5px 10px;
      color: var(--paper);
      font: 800 10px/1 var(--font-mono);
      letter-spacing: 0.15em;
      transform: rotate(-2deg);
    }
    .no-red { background: var(--red); }
    .no-teal { background: var(--teal); }
    .no-gold { background: var(--gold); }
    .trail-card p { flex: 1; }
    .go { margin-top: 22px; font-weight: 700; font-size: 13.5px; }
    .go-red { color: var(--red); }
    .go-teal { color: var(--teal); }
    .go-gold { color: #a87c22; }
    .count {
      position: absolute;
      top: 22px; right: 20px;
      color: var(--ink-faint);
      font: 700 9px/1 var(--font-mono);
      letter-spacing: 0.1em;
    }

    .crew { margin-top: 88px; }

    .crew-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px;
    }

    .crew-card { display: flex; flex-direction: column; padding-top: 32px; }

    .crew-top { display: flex; align-items: center; gap: 18px; }

    .crew-avatar {
      flex: 0 0 auto;
      width: 84px;
      height: 84px;
      overflow: hidden;
      border: 2px solid var(--ink);
      border-radius: 50%;
      background: var(--paper);
      transform: rotate(-4deg);
      transition: transform 200ms ease;
    }
    .crew-card:hover .crew-avatar { transform: rotate(0deg) scale(1.05); }
    .crew-avatar img { width: 100%; height: 100%; display: block; object-fit: cover; }

    .crew-id h3 { margin: 0; font-family: var(--font-serif); font-size: 24px; }
    .crew-breed { display: block; margin-top: 6px; color: var(--ink-soft); font: 700 11px/1.4 var(--font-mono); letter-spacing: 0.08em; }

    .crew-file { margin: 22px 0 0; display: grid; gap: 10px; }
    .crew-file > div { display: grid; grid-template-columns: 58px 1fr; gap: 10px; align-items: baseline; }
    .crew-file dt {
      padding: 3px 0;
      text-align: center;
      color: var(--teal);
      border: 1.5px solid var(--teal);
      border-radius: 3px;
      font: 700 10px/1.4 var(--font-mono);
      letter-spacing: 0.1em;
    }
    .crew-file dd { margin: 0; color: var(--ink-soft); font-size: 13.5px; line-height: 1.75; }

    .crew-quote {
      margin: 20px 0 0;
      padding-top: 16px;
      border-top: 1px dashed var(--line);
      font: 16px/1.5 var(--font-hand);
      color: var(--ink-soft);
      text-align: right;
    }

    .archive-strip {
      margin-top: 72px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border: 2px dashed var(--line);
      border-radius: var(--radius-sm);
    }
    .archive-label { color: var(--ink-faint); font: 700 9px/1.4 var(--font-mono); letter-spacing: 0.18em; white-space: nowrap; }
    .archive-tabs { display: flex; flex-wrap: wrap; gap: 10px 22px; }
    .archive-tabs a {
      color: var(--ink-soft);
      font: 600 11px/1.4 var(--font-mono);
      letter-spacing: 0.06em;
      border-bottom: 2px solid transparent;
      transition: color 150ms ease, border-color 150ms ease;
    }
    .archive-tabs a:hover { color: var(--teal); border-bottom-color: var(--teal); }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; padding-top: 8px; }
      .polaroid-stack { margin-top: 26px; }
      .card-grid { grid-template-columns: 1fr; gap: 26px; }
      .trails { margin-top: 76px; }
      .crew { margin-top: 70px; }
      .crew-grid { grid-template-columns: 1fr; gap: 26px; }
    }

    @media (max-width: 620px) {
      .stamp { right: -8px; }
      .memo { left: -6px; bottom: -60px; }
      .polaroid-stack { margin-bottom: 56px; }
      .route { max-width: none; }
      .archive-strip { flex-direction: column; align-items: flex-start; gap: 12px; }
    }
  </style>
</Base>
