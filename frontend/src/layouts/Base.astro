---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '小完能实验室 · 两只猫的探索手账' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页', code: '00' },
  { href: '/docs/', label: '文档', code: '01' },
  { href: '/tools/', label: '工具', code: '02' },
  { href: '/skills/', label: 'Skills', code: '03' },
  { href: '/development/', label: '开发文档', code: 'DEV', internal: true },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5efe2" />
    <link rel="icon" type="image/png" href="/favicon.png?v=two-cats" />
    <link rel="apple-touch-icon" href="/assets/brand-icon.png?v=two-cats" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page-texture" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="返回小完能实验室首页">
          <span class="brand-mark">
            <img src="/assets/brand-icon.png?v=two-cats" alt="" width="42" height="42" />
          </span>
          <span class="brand-copy">
            <strong>小完能实验室</strong>
            <small>XWN FIELD NOTES</small>
          </span>
        </a>

        <nav aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.href), internal: item.internal }}>
              <span>{item.label}</span>
              <small>{item.code}</small>
            </a>
          ))}
        </nav>

        <div class="system-status" title="两只猫在岗">
          TWO CATS<br />ONE LAB
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>小完能实验室</strong>
          <p>一些记录，一些装备，一些能送给同路人的本领。</p>
        </div>
        <p class="footer-sign">
          球球出主意，十一把事情做完。
          <small>© {new Date().getFullYear()} XWN·LAB · BUILT FROM SOURCE</small>
        </p>
      </div>
    </footer>
  </body>
</html>
