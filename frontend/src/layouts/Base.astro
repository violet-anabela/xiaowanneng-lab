---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '小完能实验室 · 两只咪的探索手账' } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/', label: '大本营', code: '00' },
  { href: '/docs/', label: '手账', code: '01' },
  { href: '/tools/', label: '装备', code: '02' },
  { href: '/skills/', label: '小鱼干', code: '03' },
  { href: '/gallery/', label: '猫片', code: '04' },
  { href: '/development/', label: '队内档案', code: 'DEV', internal: true },
];

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5efe2" />
    <link rel="icon" type="image/png" href="/favicon.png?v=two-cats" />
    <link rel="apple-touch-icon" href="/assets/brand-poster.png?v=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page-texture" aria-hidden="true"></div>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="返回小完能实验室首页">
          <span class="brand-mark">
            <img src="/assets/brand-poster.png?v=1" alt="" width="42" height="42" />
          </span>
          <span class="brand-copy">
            <strong>小完能实验室</strong>
            <small>XWN FIELD NOTES</small>
          </span>
        </a>

        <nav aria-label="主导航">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: isActive(item.href), internal: item.internal }}>
              <span>{item.label}</span>
              <small>{item.code}</small>
            </a>
          ))}
        </nav>

        <div class="system-status" title="两只咪在岗">
          TWO CATS<br />ONE LAB
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>小完能实验室</strong>
          <p>两只咪的手账、装备，和晒好的小鱼干。</p>
        </div>
        <p class="footer-sign">
          球球出主意，十一把事情做完。<i class="paw-i" aria-hidden="true" style="color: var(--gold); transform: rotate(14deg);"></i><i class="paw-i" aria-hidden="true" style="color: var(--red); font-size: 0.8em; transform: rotate(32deg) translateY(-0.3em);"></i>
          <small>© {new Date().getFullYear()} XWN·LAB · BUILT FROM SOURCE</small>
        </p>
      </div>
    </footer>

    <script is:inline>
      // 桌宠 loader：领养过（localStorage 有记录）才加载引擎，普通访客零开销。
      (function () {
        try {
          var saved = JSON.parse(localStorage.getItem('xwn-pet') || 'null');
          if (!saved || !(saved.image || (saved.images && saved.images.idle))) return;
          var s = document.createElement('script');
          s.src = '/pet/xwn-pet.js?v=3'; // 引擎有更新时同步递增（desktop-pet.astro 里还有一处）
          s.onload = function () { window.XwnPet && window.XwnPet.mount(saved); };
          document.body.appendChild(s);
        } catch (e) { /* 宠物走丢也不能影响页面 */ }
      })();
    </script>
  </body>
</html>
